# 复制为 .env 后填写；.env 已被 .gitignore 忽略。不填也能用，只是没有 AI 功能
# 任意 OpenAI 兼容接口均可（火山引擎 Ark、DeepSeek、通义等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# KANBAN_MODEL=ark-code-latest

# 联网搜索（JD 抓取、公司调研）：https://tavily.com/
TAVILY_API_KEY=
# TAVILY_SEARCH_DEPTH=basic

# 微信提醒（Server 酱）：https://sct.ftqq.com/
SERVERCHAN_KEY=

# 与「求职助手」联动，默认 ~/Desktop/job-hunter/backend/ 下的文件
# JOB_HUNTER_DB=
# JOB_HUNTER_RESUME=
